              </div>
            </div>

            <!-- Content Details -->
            <div class="p-6 flex-1 flex flex-col justify-between space-y-4">
              <div>
                <h3 class="font-display text-lg font-bold text-white group-hover:text-blue-300 transition-colors line-clamp-1">
                  ${item.title}
                </h3>
                <p class="text-xs text-slate-400 mt-2 leading-relaxed line-clamp-2">
                  ${item.description}
                </p>
              </div>

              <!-- Pricing & Rental Duration Selector -->
