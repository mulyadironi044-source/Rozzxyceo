        btnDaily.className = "px-2.5 py-1 rounded-md text-[11px] font-bold bg-blue-600 text-white transition-all";
        btnWeekly.className = "px-2.5 py-1 rounded-md text-[11px] font-bold text-slate-400 hover:text-white transition-all";
        priceDisplay.textContent = formatIDR(item.rentalDaily);
        unitDisplay.textContent = "/ hari";
      }
    }

    // CART STATE MANAGEMENT
    function addToCart(itemId) {
      const item = state.items.find(i => i.id === itemId);
      if (!item) return;

      const duration = itemDurations[itemId] || 'daily';
      let effectivePrice = item.price;
      let durationLabel = '';

      if (item.type === 'rental') {
        if (duration === 'weekly') {
          effectivePrice = item.rentalWeekly || (item.rentalDaily * 6);
          durationLabel = 'Sewa 1 Minggu (7 Hari)';
        } else {
          effectivePrice = item.rentalDaily;
          durationLabel = 'Sewa 1 Hari';
        }
      }

      // Check if item already exists in cart with same duration
      const existingIdx = state.cart.findIndex(c => c.id === item.id && c.duration === duration);
      if (existingIdx > -1) {
        state.cart[existingIdx].qty += 1;
      } else {
        state.cart.push({
          cartId: `${item.id}-${Date.now()}`,
          id: item.id,
          type: item.type,
          category: item.category,
          title: item.title,
          image: item.image,
          price: effectivePrice,
          duration: duration,
          durationLabel: durationLabel,
          qty: 1
        });
      }

      updateCartBadge();
      renderCartDrawer();
      showToast(`Berhasil menambahkan "${item.title}" ke keranjang!`);
    }

