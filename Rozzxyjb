    const itemDurations = {}; // store chosen duration: 'daily' | 'weekly'
    function selectDuration(itemId, duration) {
      itemDurations[itemId] = duration;
      const item = state.items.find(i => i.id === itemId);
      if (!item) return;

      const btnDaily = document.getElementById(`dur-daily-${itemId}`);
      const btnWeekly = document.getElementById(`dur-weekly-${itemId}`);
      const priceDisplay = document.getElementById(`price-display-${itemId}`);
      const unitDisplay = document.getElementById(`unit-display-${itemId}`);

      if (duration === 'weekly') {
        btnDaily.className = "px-2.5 py-1 rounded-md text-[11px] font-bold text-slate-400 hover:text-white transition-all";
        btnWeekly.className = "px-2.5 py-1 rounded-md text-[11px] font-bold bg-indigo-600 text-white transition-all";
        priceDisplay.textContent = formatIDR(item.rentalWeekly || item.rentalDaily * 6);
        unitDisplay.textContent = "/ 7 hari (Mingguan)";
