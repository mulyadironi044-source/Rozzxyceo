            <p class="text-xs text-slate-400 mt-1">Pilih item dari kategori Shop atau Rental Gear untuk mulai transaksi.</p>
            <button onclick="toggleCartDrawer(false)" class="mt-4 px-5 py-2.5 rounded-xl bg-blue-600 hover:bg-blue-500 text-white text-xs font-bold transition-all">
              Mulai Eksplorasi
            </button>
          </div>
        `;
        subtotalEl.textContent = 'Rp 0';
        totalEl.textContent = 'Rp 0';
        checkoutBtn.disabled = true;
        lucide.createIcons();
        return;
      }

      checkoutBtn.disabled = false;
      let totalAmount = 0;

      container.innerHTML = state.cart.map((cartItem, idx) => {
        const itemSubtotal = cartItem.price * cartItem.qty;
        totalAmount += itemSubtotal;

        return `
          <div class="p-4 rounded-2xl bg-slate-950 border border-slate-800 flex gap-3.5 items-center">
            <img src="${cartItem.image}" alt="${cartItem.title}" class="w-16 h-16 rounded-xl object-cover bg-slate-900 border border-slate-800">
            <div class="flex-1 min-w-0">
              <span class="text-[9px] uppercase font-bold tracking-wider px-1.5 py-0.5 rounded ${cartItem.type === 'rental' ? 'bg-indigo-500/20 text-indigo-300' : 'bg-blue-500/20 text-blue-300'}">
                ${cartItem.type === 'rental' ? cartItem.durationLabel : 'Beli (Shop)'}
              </span>
              <h4 class="text-xs font-bold text-white truncate mt-1">${cartItem.title}</h4>
              <p class="text-xs font-semibold text-blue-400 mt-0.5">${formatIDR(cartItem.price)}</p>
              
              <div class="flex items-center justify-between mt-2.5">
                <div class="flex items-center gap-2 bg-slate-900 rounded-lg p-1 border border-slate-800">
                  <button onclick="changeQty(${idx}, -1)" class="w-5 h-5 flex items-center justify-center text-slate-400 hover:text-white rounded hover:bg-slate-800 text-xs">-</button>
                  <span class="text-xs font-bold text-slate-200 px-1">${cartItem.qty}</span>
                  <button onclick="changeQty(${idx}, 1)" class="w-5 h-5 flex items-center justify-center text-slate-400 hover:text-white rounded hover:bg-slate-800 text-xs">+</button>
                </div>
                <button onclick="removeFromCart(${idx})" class="text-xs text-rose-400 hover:text-rose-300 transition-colors p-1">
                  <i data-lucide="trash-2" class="w-4 h-4"></i>
                </button>
              </div>
            </div>
          </div>
        `;
      }).join('');

      subtotalEl.textContent = formatIDR(totalAmount);
      totalEl.textContent = formatIDR(totalAmount);
      lucide.createIcons();
    }

    function changeQty(index, delta) {
      if (!state.cart[index]) return;
      state.cart[index].qty += delta;
      if (state.cart[index].qty <= 0) {
        state.cart.splice(index, 1);
      }
      updateCartBadge();
      renderCartDrawer();
    }

    function removeFromCart(index) {
      state.cart.splice(index, 1);
      updateCartBadge();
      renderCartDrawer();
      showToast('Item berhasil dihapus dari keranjang.');
    }

    // CHECKOUT MODAL OPERATIONS
    function openCheckoutModal() {
      toggleCartDrawer(false);
      const modal = document.getElementById('checkout-modal');
      const totalAmount = state.cart.reduce((sum, item) => sum + (item.price * item.qty), 0);
      const totalCount = state.cart.reduce((sum, item) => sum + item.qty, 0);

      document.getElementById('checkout-final-total').textContent = formatIDR(totalAmount);
      document.getElementById('checkout-items-summary-text').textContent = `${totalCount} item (${state.cart.map(c => c.title).slice(0,2).join(', ')}${state.cart.length > 2 ? '...' : ''})`;

      modal.classList.remove('opacity-0', 'pointer-events-none');
      modal.classList.add('opacity-100');
      modal.firstElementChild.classList.remove('scale-95');
      modal.firstElementChild.classList.add('scale-100');
      lucide.createIcons();
    }

    function closeCheckoutModal() {
      const modal = document.getElementById('checkout-modal');
      modal.classList.add('opacity-0', 'pointer-events-none');
      modal.classList.remove('opacity-100');
      modal.firstElementChild.classList.add('scale-95');
      modal.firstElementChild.classList.remove('scale-100');
    }

    function processSimulatedPayment() {
      closeCheckoutModal();
      // Generate randomized Order ID
      const orderNum = Math.floor(10000 + Math.random() * 90000);
      document.getElementById('order-id-display').textContent = `#RZ-${orderNum}`;
      
      // Empty cart
      state.cart = [];
      updateCartBadge();

      // Show Success Modal
      const successModal = document.getElementById('payment-success-modal');
      successModal.classList.remove('opacity-0', 'pointer-events-none');
      successModal.classList.add('opacity-100');
      successModal.firstElementChild.classList.remove('scale-95');
      successModal.firstElementChild.classList.add('scale-100');
      lucide.createIcons();
    }

    function closeSuccessModal() {
      const successModal = document.getElementById('payment-success-modal');
      successModal.classList.add('opacity-0', 'pointer-events-none');
      successModal.classList.remove('opacity-100');
      successModal.firstElementChild.classList.add('scale-95');
      successModal.firstElementChild.classList.remove('scale-100');
    }

    // ====================================================
    // ADMIN DASHBOARD CRUD & CHANNEL STATE ENGINE
    // ====================================================
    function switchAdminTab(tab) {
      state.adminSubTab = tab;
      const btnProd = document.getElementById('admin-tab-btn-products');
      const btnChan = document.getElementById('admin-tab-btn-channels');
      const subProd = document.getElementById('admin-subtab-products');
      const subChan = document.getElementById('admin-subtab-channels');

      if (tab === 'products') {
        btnProd.className = "px-4 py-2 rounded-xl text-xs font-bold bg-blue-600 text-white transition-all flex items-center gap-2";
        btnChan.className = "px-4 py-2 rounded-xl text-xs font-bold text-slate-400 hover:text-white hover:bg-slate-800 transition-all flex items-center gap-2";
        subProd.classList.remove('hidden');
        subChan.classList.add('hidden');
      } else {
        btnChan.className = "px-4 py-2 rounded-xl text-xs font-bold bg-blue-600 text-white transition-all flex items-center gap-2";
        btnProd.className = "px-4 py-2 rounded-xl text-xs font-bold text-slate-400 hover:text-white hover:bg-slate-800 transition-all flex items-center gap-2";
        subChan.classList.remove('hidden');
        subProd.classList.add('hidden');
      }
      lucide.createIcons();
    }

    function updateAdminMetrics() {
      document.getElementById('admin-metric-total').textContent = state.items.length;
      document.getElementById('admin-metric-shop').textContent = state.items.filter(i => i.type === 'shop').length;
      document.getElementById('admin-metric-rental').textContent = state.items.filter(i => i.type === 'rental').length;
    }

    function adminFilterSearch(val) {
      state.adminSearch = val.toLowerCase();
      renderAdminTable();
    }

    function renderAdminTable() {
      const tbody = document.getElementById('admin-products-table-body');
      let filtered = state.items;

      if (state.adminSearch) {
        filtered = filtered.filter(i => 
          i.title.toLowerCase().includes(state.adminSearch) || 
          i.description.toLowerCase().includes(state.adminSearch)
        );
      }

      if (filtered.length === 0) {
        tbody.innerHTML = `
          <tr>
            <td colspan="5" class="p-8 text-center text-slate-500">
              Tidak ada data produk yang cocok dengan pencarian admin.
            </td>
          </tr>
        `;
        return;
      }

      tbody.innerHTML = filtered.map(item => {
        const isRental = item.type === 'rental';
        const priceInfo = isRental 
          ? `<div><span class="font-bold text-indigo-400">${formatIDR(item.rentalDaily)}</span><span class="text-[10px] text-slate-400">/hari</span></div><div class="text-[10px] text-slate-400 mt-0.5">Mingguan: ${formatIDR(item.rentalWeekly)}</div>`
          : `<div><span class="font-bold text-blue-400">${formatIDR(item.price)}</span></div>`;
        const catLabel = categoryLabels[item.category] || item.category || '-';

        return `
          <tr class="hover:bg-slate-900/40 transition-colors">
            <td class="p-4">
              <div class="flex items-center gap-3">
                <img src="${item.image}" alt="${item.title}" class="w-12 h-12 rounded-xl object-cover bg-slate-950 border border-slate-800">
                <div>
                  <h4 class="font-bold text-white text-xs">${item.title}</h4>
                  <span class="text-[10px] text-slate-500">ID: ${item.id}</span>
                </div>
              </div>
            </td>
            <td class="p-4">
              <div class="space-y-1">
                <span class="inline-block px-2 py-0.5 rounded-full text-[10px] font-extrabold uppercase tracking-wider ${isRental ? 'bg-indigo-500/10 text-indigo-300 border border-indigo-500/30' : 'bg-blue-500/10 text-blue-300 border border-blue-500/30'}">
                  ${isRental ? 'Rental Gear' : 'Dijual (Shop)'}
                </span>
                <span class="block text-[11px] text-slate-400">${catLabel}</span>
              </div>
            </td>
            <td class="p-4">
              ${priceInfo}
            </td>
            <td class="p-4 max-w-xs">
              <p class="truncate text-slate-400 text-xs">${item.description}</p>
            </td>
            <td class="p-4 text-right">
              <div class="flex items-center justify-end gap-2">
                <button onclick="openEditModal('${item.id}')" class="p-2 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-200 hover:text-white transition-colors" title="Ubah Nama, Harga, Deskripsi, Foto">
                  <i data-lucide="edit-2" class="w-3.5 h-3.5"></i>
                </button>
                <button onclick="deleteProduct('${item.id}')" class="p-2 rounded-lg bg-rose-950/40 hover:bg-rose-900/60 text-rose-400 hover:text-rose-200 border border-rose-800/40 transition-colors" title="Hapus Produk">
                  <i data-lucide="trash" class="w-3.5 h-3.5"></i>
                </button>
              </div>
            </td>
          </tr>
        `;
      }).join('');

      lucide.createIcons();
    }

    // PRODUCT CREATE / EDIT MODAL LOGIC
    function openCreateModal() {
      document.getElementById('product-modal-title').textContent = "Tambah Produk / Gear Baru";
      document.getElementById('form-item-id').value = "";
      document.getElementById('form-title').value = "";
      document.getElementById('form-category').value = "camera";
      document.getElementById('form-type').value = "shop";
      document.getElementById('form-price').value = "500000";
      document.getElementById('form-weekly-price').value = "2500000";
      document.getElementById('form-image').value = "https://images.unsplash.com/photo-1516035069371-29a1b244cc32?auto=format&fit=crop&w=800&q=80";
      document.getElementById('form-description').value = "";

      toggleFormRentalInputs();
      showProductModal();
    }

    function openEditModal(itemId) {
      const item = state.items.find(i => i.id === itemId);
      if (!item) return;

      document.getElementById('product-modal-title').textContent = "Edit Produk / Gear Inventaris";
      document.getElementById('form-item-id').value = item.id;
      document.getElementById('form-title').value = item.title;
      document.getElementById('form-category').value = item.category || "camera";
      document.getElementById('form-type').value = item.type;
      document.getElementById('form-price').value = item.type === 'rental' ? item.rentalDaily : item.price;
      document.getElementById('form-weekly-price').value = item.rentalWeekly || (item.rentalDaily ? item.rentalDaily * 6 : 0);
      document.getElementById('form-image').value = item.image;
      document.getElementById('form-description').value = item.description;

      toggleFormRentalInputs();
      showProductModal();
    }

    function toggleFormRentalInputs() {
      const type = document.getElementById('form-type').value;
      const weeklyGroup = document.getElementById('form-rental-weekly-group');
      if (type === 'rental') {
        weeklyGroup.classList.remove('hidden');
      } else {
        weeklyGroup.classList.add('hidden');
      }
    }

    function setPresetImg(type) {
      const imgInput = document.getElementById('form-image');
      if (type === 'camera') imgInput.value = 'https://images.unsplash.com/photo-1516035069371-29a1b244cc32?auto=format&fit=crop&w=800&q=80';
      if (type === 'drone') imgInput.value = 'https://images.unsplash.com/photo-1508614589041-895b88991e3e?auto=format&fit=crop&w=800&q=80';
      if (type === 'lens') imgInput.value = 'https://images.unsplash.com/photo-1617005082133-548c4dd27f35?auto=format&fit=crop&w=800&q=80';
    }

    function showProductModal() {
      const modal = document.getElementById('product-modal');
      modal.classList.remove('opacity-0', 'pointer-events-none');
      modal.classList.add('opacity-100');
      modal.firstElementChild.classList.remove('scale-95');
      modal.firstElementChild.classList.add('scale-100');
      lucide.createIcons();
    }

    function closeProductModal() {
      const modal = document.getElementById('product-modal');
      modal.classList.add('opacity-0', 'pointer-events-none');
      modal.classList.remove('opacity-100');
      modal.firstElementChild.classList.add('scale-95');
      modal.firstElementChild.classList.remove('scale-100');
    }

    function handleProductFormSubmit(e) {
      e.preventDefault();
      const id = document.getElementById('form-item-id').value;
      const title = document.getElementById('form-title').value.trim();
      const category = document.getElementById('form-category').value;
      const type = document.getElementById('form-type').value;
      const priceVal = parseFloat(document.getElementById('form-price').value);
      const weeklyVal = parseFloat(document.getElementById('form-weekly-price').value) || (priceVal * 6);
      const image = document.getElementById('form-image').value.trim();
      const description = document.getElementById('form-description').value.trim();

      if (id) {
        // UPDATE EXISTING ITEM
        const index = state.items.findIndex(i => i.id === id);
        if (index > -1) {
          state.items[index].title = title;
          state.items[index].category = category;
          state.items[index].type = type;
          state.items[index].image = image;
          state.items[index].description = description;

          if (type === 'rental') {
            state.items[index].rentalDaily = priceVal;
            state.items[index].rentalWeekly = weeklyVal;
            state.items[index].price = priceVal;
          } else {
            state.items[index].price = priceVal;
            state.items[index].rentalDaily = null;
            state.items[index].rentalWeekly = null;
          }
          showToast(`Produk "${title}" berhasil diperbarui!`);
        }
      } else {
        // CREATE NEW ITEM
        const newItem = {
          id: `item-${Date.now()}`,
          type: type,
          category: category,
          title: title,
          description: description,
          image: image,
          price: priceVal,
          rentalDaily: type === 'rental' ? priceVal : null,
          rentalWeekly: type === 'rental' ? weeklyVal : null,
          stock: 'Baru Ditambahkan'
        };
        state.items.unshift(newItem);
        showToast(`Produk baru "${title}" berhasil ditambahkan ke katalog!`);
      }

      closeProductModal();
      renderAdminTable();
      updateAdminMetrics();
      renderCatalog(); // Real-time front-end synchronization
    }

    function deleteProduct(itemId) {
      const item = state.items.find(i => i.id === itemId);
      if (!item) return;

      if (confirm(`Apakah Anda yakin ingin menghapus "${item.title}" dari inventaris?`)) {
        state.items = state.items.filter(i => i.id !== itemId);
        showToast(`Item "${item.title}" telah dihapus.`);
        renderAdminTable();
        updateAdminMetrics();
        renderCatalog();
      }
    }

    // ====================================================
    // STATE MANAGEMENT: SALURAN KOMUNIKASI (SYNC TO FRONT-END)
    // ====================================================
    function saveChannelSettings(e) {
      e.preventDefault();
      const newWa = document.getElementById('cfg-wa').value.trim();
      const newTg = document.getElementById('cfg-tg').value.trim();
      const newEmail = document.getElementById('cfg-email').value.trim();

      // Update state
      state.channels.whatsapp = newWa;
      state.channels.telegram = newTg;
      state.channels.email = newEmail;

      // Real-time synchronization to front-end elements
      syncChannelsToFrontEnd();

      // Visual feedback
      const syncStatus = document.getElementById('channel-sync-status');
      syncStatus.classList.remove('hidden');
      setTimeout(() => syncStatus.classList.add('hidden'), 3500);

      showToast("Saluran Komunikasi Admin berhasil disinkronkan ke Front-end!");
    }

    function syncChannelsToFrontEnd() {
      // Clean phone number for WhatsApp URL
      const cleanWa = state.channels.whatsapp.replace(/[^0-9]/g, '');
      const waLink = document.getElementById('public-wa-link');
      const waDisplay = document.getElementById('public-wa-display');
      waLink.href = `https://wa.me/${cleanWa}`;
      waDisplay.textContent = state.channels.whatsapp;

      // Telegram
      const cleanTg = state.channels.telegram.replace('@', '');
      const tgLink = document.getElementById('public-tg-link');
      const tgDisplay = document.getElementById('public-tg-display');
      tgLink.href = `https://t.me/${cleanTg}`;
      tgDisplay.textContent = state.channels.telegram;

      // Email
      const emailLink = document.getElementById('public-email-link');
      const emailDisplay = document.getElementById('public-email-display');
      emailLink.href = `mailto:${state.channels.email}`;
      emailDisplay.textContent = state.channels.email;
    }

    // INITIALIZATION & SCROLL REVEAL OBSERVER
    document.addEventListener('DOMContentLoaded', () => {
      lucide.createIcons();
      renderCatalog();
      syncChannelsToFrontEnd();

      // Simple intersection observer for smooth scroll reveal
      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add('active');
          }
        });
      }, { threshold: 0.1 });

      document.querySelectorAll('.reveal').forEach(el => observer.observe(el));
    });
  </script>
</body></html>
