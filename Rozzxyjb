      const borderCol = type === 'success' ? 'border-emerald-500/50' : 'border-blue-500/50';
      const textCol = type === 'success' ? 'text-emerald-400' : 'text-blue-400';

      toast.className = `pointer-events-auto flex items-center gap-2.5 px-4 py-3 rounded-xl bg-slate-900/95 border ${borderCol} shadow-2xl backdrop-blur-md text-xs font-semibold text-slate-100 transform translate-y-3 opacity-0 transition-all duration-300`;
