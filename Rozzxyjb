      // 1. Filter by transaction type (all, shop, rental)
      if (state.catalogFilter !== 'all') {
        filtered = filtered.filter(item => item.type === state.catalogFilter);
      }

      // 2. Filter by specific category
      if (state.specificCategory !== 'all') {
        filtered = filtered.filter(item => item.category === state.specificCategory);
      }

      // 3. Filter by search query
      if (state.searchQuery) {
        filtered = filtered.filter(item => 
          item.title.toLowerCase().includes(state.searchQuery) ||
          item.description.toLowerCase().includes(state.searchQuery) ||
          (item.category && item.category.toLowerCase().includes(state.searchQuery))
        );
      }

      document.getElementById('items-count-badge').textContent = `${filtered.length} Item Tersedia`;

      if (filtered.length === 0) {
